{
  "name": "@dictu/video",
  "description": "Flexible video JavaScript library.",
  "version": "1.1.7",
  "main": "dist/video.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drupalgovnl/video.git"
  },
  "homepage": "https://github.com/drupalgovnl/video#readme",
  "bugs": {
    "url": "https://github.com/drupalgovnl/video/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.0",
    "@babel/eslint-parser": "^7.17.0",
    "@babel/preset-env": "^7.16.11",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.3.0",
    "rollup": "^2.67.2",
    "terser": "^5.10.0"
  },
  "dependencies": {
    "srt-webvtt": "^2.0.0"
  },
  "scripts": {
    "build": "npm run compile && npm run minify",
    "compile": "rollup --config",
    "minify": "terser dist/video.js --compress --mangle --keep-classnames --output dist/video.min.js",
    "lint": "eslint 'src/**/*.js'"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie >= 0",
    "not dead"
  ]
